# Gemini Flash — get a key at https://aistudio.google.com/apikey.
# IMPORTANT: use a Google Cloud project with BILLING DISABLED. Google cannot charge
# such a key; requests past the free quota just return 429.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Tried in order if GEMINI_MODEL is retired (Google 404s old ids without notice)
GEMINI_MODEL_FALLBACKS=gemini-flash-lite-latest,gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_MAX_RETRIES=3
# Guardrails so the free tier is never exceeded (belt and braces alongside the
# billing-disabled key). Budget is per calendar day and persists in data/gemini_usage.json.
# Deliberately well under the quota: failed requests still consume it, so a retry
# loop must not be able to burn the day's allowance. Rate limits apply per PROJECT,
# not per key, and Google no longer publishes the free-tier numbers — check the
# "View your active rate limits" link in AI Studio for your account's real ceiling.
GEMINI_RPM=8
GEMINI_DAILY_REQUEST_BUDGET=300
# Batching: jobs per request (fewer requests = less free-tier usage)
LLM_SCORE_WORKERS=2
LLM_SCORE_BATCH_SIZE=8
LLM_DESC_TRUNCATE=2000
LLM_MISSION_BATCH_SIZE=20
LLM_MISSION_WORKERS=2
# Auto-approve curated employers at or above this mission_score (liberal default: 50)
MISSION_APPROVE_MIN_SCORE=50
REGISTRY_LLM_FILTER=true
OLLAMA_KEEP_ALIVE=30m
# Digest: 0 = all scored jobs; raise (e.g. 65) to drop low combined scores from email
MIN_COMBINED_SCORE=0
# Digest floor on the LLM candidate_fit score; 0 = disabled
MIN_CANDIDATE_FIT=40
# Max jobs per digest section; 0 = unlimited
DIGEST_TOP_N=50
# Explicit .env value wins; profile/preferences.yaml digest.remote_only is the fallback
DIGEST_REMOTE_ONLY=true
SCORE_MAX_PER_RUN=0
# Only score jobs posted (or first seen by us) within N days; 0 = disabled
SCORE_MAX_AGE_DAYS=30
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=
SQLITE_PATH=data/jobs.db
PROFILE_PATH=profile/profile.md
PREFERENCES_PATH=profile/preferences.yaml
# Curated ATS: parallel polls (--limit N on ingest caps companies for testing)
INGEST_WORKERS=10
INGEST_DELAY_MS=150
# Poll floor(total / N) curated employers per ingest, stalest first (1 = poll all daily)
CURATED_POLL_ROTATION_DIVISOR=1
SMARTRECRUITERS_API_KEY=
# Title gate before fetching job details / LLM (word-boundary match).
# Discipline excludes (software engineer, frontend, devops, ...) only drop titles
# WITHOUT a data/analytics/AI qualifier — "Data Software Engineer" still passes.
TARGET_ROLE_KEYWORDS=artificial intelligence engineer,analytics engineer,analytics engineering,ai engineer,data engineer,data engineering,data integration,data integrations,data platform engineer,etl engineer
EXCLUDE_TITLE_KEYWORDS=intern,internship,software engineer,software developer,frontend engineer,front-end engineer,backend engineer,back-end engineer,full stack,fullstack,devops,site reliability,sre,mobile engineer,ios engineer,android engineer,qa engineer,quality engineer,security engineer,sales engineer,product engineer,mechanical engineer,civil engineer,field engineer,manufacturing engineer,customer success,account executive,recruiter,marketing manager,machine learning,ml engineer,mlops
# Title-level seniority gate (word-boundary); empty = disabled
SENIORITY_EXCLUDE_KEYWORDS=senior,staff,principal,lead,head,director,vp,chief,manager,graduate,working student,trainee
# BigQuery: read curated_companies; batch-load jobs_normalized (free tier friendly, no streaming)
BQ_ENABLED=true
BQ_PROJECT_ID=your-gcp-project-id
BQ_DATASET_ID=good_jobs_digest
BQ_LOCATION=EU
BQ_WRITE_JOBS=true
BQ_WRITE_RAW_PAYLOADS=false
BQ_WRITE_LLM_SCORES=false
BQ_WRITE_DIGEST_HISTORY=false
# Batch BQ job merges at end of ingest (not per-row during ingest)
BQ_MERGE_ON_INGEST=false
BQ_BATCH_NORMALIZED=true
# Place the service account JSON at config/service_account.json (gitignored) or set an absolute path:
GOOGLE_APPLICATION_CREDENTIALS=config/service_account.json
# After credentials work, run once: python main.py init-bq
# Curated employers: shipped CSV used when BigQuery curated_companies is empty
# CURATED_COMPANIES_PATH=registry/curated_companies.csv

# ReliefWeb Jobs API — request an approved appname (API no longer accepts self-declared names):
# https://apidoc.reliefweb.int/parameters#appname
# Dropped: the appname was never approved. Set true + a real appname to bring it back.
RELIEFWEB_ENABLED=false
RELIEFWEB_APPNAME=

# Zero-yield HTML scrapers (disabled by default)
BOARD_IDEALIST_ENABLED=false
BOARD_IMPACTPOOL_ENABLED=false
BOARD_AAC_ENABLED=false
BOARD_WORKONCLIMATE_ENABLED=false

# New API boards
BOARD_REMOTIVE_ENABLED=true
BOARD_ARBEITNOW_ENABLED=true
BOARD_JOBICY_ENABLED=true
BOARD_HIMALAYAS_ENABLED=true
BOARD_ARBEITNOW_MAX_PAGES=5
BOARD_JOBICY_COUNT=50
BOARD_JOBICY_GEO=emea
BOARD_HIMALAYAS_LIMIT=100

# Cache EmployerMissionFilter verdicts; gate board jobs before scoring
EMPLOYER_MISSION_GATE_ENABLED=true

# Mission job boards (Climatebase, 80k Hours, Escape the City, Tech Jobs for Good, ReliefWeb, …)
JOB_BOARDS_ENABLED=true
BOARD_INGEST_DELAY_MS=2000
BOARD_DETAIL_DELAY_MS=1500
BOARD_PAUSE_BETWEEN_MS=3000
CLIMATEBASE_MAX_LISTINGS=100
CLIMATEBASE_FETCH_DETAILS=true
BOARD_80000HOURS_MAX_PAGES=3
BOARD_ESCAPETHECITY_MAX_PAGES=3
TJFG_FETCH_DETAILS=true
RELIEFWEB_JOBS_LIMIT=200

# Remote/EU aggregator boards. All are keyless public APIs; the employer mission
# gate (EMPLOYER_MISSION_GATE_ENABLED) keeps non-mission employers out of the digest.
BOARD_REMOTIVE_ENABLED=true
BOARD_ARBEITNOW_ENABLED=true
BOARD_ARBEITNOW_MAX_PAGES=5
BOARD_JOBICY_ENABLED=true
BOARD_JOBICY_GEO=emea
BOARD_JOBICY_COUNT=50
# Himalayas serves 20 per page; the limit is reached by walking offsets.
BOARD_HIMALAYAS_ENABLED=true
BOARD_HIMALAYAS_LIMIT=200
BOARD_REMOTEOK_ENABLED=true
BOARD_WEWORKREMOTELY_ENABLED=true
BOARD_WORKINGNOMADS_ENABLED=true
BOARD_HN_ENABLED=true
BOARD_HN_MAX_COMMENTS=400
# Indeed via python-jobspy (optional dependency; set false if not installed)
BOARD_INDEED_ENABLED=true
INDEED_COUNTRIES=Germany,Netherlands,Poland,Ireland,Spain
INDEED_SEARCH_TERMS=data engineer,analytics engineer,data platform engineer
INDEED_RESULTS_WANTED=25
# Zero-yield HTML scrapers, off by default
BOARD_IDEALIST_ENABLED=false
BOARD_IMPACTPOOL_ENABLED=false
BOARD_AAC_ENABLED=false
BOARD_WORKONCLIMATE_ENABLED=false
# Cache mission verdicts per employer so each is judged by the LLM only once
EMPLOYER_MISSION_GATE_ENABLED=true
# Digest includes all scored unsent jobs when MIN_COMBINED_SCORE=0 (no row cap)
# Webshare proxies (HOST:PORT:USER:PASS per line). The cached file is refreshed
# automatically when older than WEBSHARE_PROXY_MAX_AGE_HOURS — free proxies get
# rotated without notice, so a stale file means silently dead proxies.
# Prefer WEBSHARE_API_KEY: it reports which proxies are still valid and keeps the
# token out of a shareable URL. WEBSHARE_PROXY_LIST_URL is the fallback.
WEBSHARE_PROXIES_PATH=config/webshare_proxies.txt
WEBSHARE_API_KEY=
WEBSHARE_PROXY_MAX_AGE_HOURS=12
WEBSHARE_PROXY_LIST_URL=

# B Corp Typesense API (public search key from frontend bundles)
BCORP_TYPESENSE_API_KEY=
# EU-first B Corp crawl (hqCountry facet). Set BCORP_EU_ONLY=false for unfiltered.
BCORP_EU_ONLY=true
# Optional explicit Typesense filter_by (overrides BCORP_EU_ONLY when set)
# BCORP_COUNTRY_FILTER=hqCountry:=[Germany, France, Netherlands The]
